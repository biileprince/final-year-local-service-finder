# =============================================================================
# Local Service Finder - Backend env template
# Copy to .env (or .env.local) and fill values. Boot fail-fasts on missing or
# invalid required vars (see src/config/env.validation.ts).
# =============================================================================

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Optional comma-separated allowlist (apex + www + previews etc). When set,
# takes precedence over FRONTEND_URL for CORS / WS origin checks.
# Example: FRONTEND_URLS=https://app.example.com,https://www.example.com
FRONTEND_URLS=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://lsf_user:lsf_password@localhost:5432/local_service_finder

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (generate: openssl rand -base64 48) ---
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies / CSRF (required in production) ---
COOKIE_DOMAIN=localhost
COOKIE_SECRET=change_me_min_16_chars

# --- Cloudinary (required in production) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email / SendGrid (required in production) ---
SENDGRID_API_KEY=
EMAIL_FROM=noreply@localservicefinder.com
EMAIL_FROM_NAME=Local Service Finder

# --- SMS (choose one provider; required in production) ---
SMS_PROVIDER=africas_talking
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SHORTCODE=
# Twilio (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sentry (optional) ---
SENTRY_DSN=https://816dfe73fbc906e1eee26e9ee53fe821@o4511468317114368.ingest.de.sentry.io/4511468729860176
# Release tag. On Heroku, enable dyno metadata to auto-populate the commit SHA:
#   heroku labs:enable runtime-dyno-metadata -a <app>
# which sets HEROKU_SLUG_COMMIT (used as a fallback). Otherwise set explicitly.
SENTRY_RELEASE=
