# ==============================================================================
# Local Service Finder - Backend Environment Configuration
# ==============================================================================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://lsf_user:lsf_password@localhost:5432/local_service_finder

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Cloudinary - Phase 3)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Email (SendGrid - Phase 3)
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@localservicefinder.com

# SMS (Twilio - Phase 3)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn
