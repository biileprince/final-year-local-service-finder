# Used by docker-compose at the repo root.
# Copy to .env and adjust as needed.

# PostgreSQL
POSTGRES_USER=lsf_user
POSTGRES_PASSWORD=lsf_password
POSTGRES_DB=local_service_finder

# Redis
REDIS_PASSWORD=redis_password

# Auth (must match backend/.env JWT_SECRET)
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# Grafana (only used with --profile monitoring)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin 
