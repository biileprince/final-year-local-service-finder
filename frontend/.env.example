# Environment Variables
# Copy this file to .env.local and fill in the values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# App Configuration
NEXT_PUBLIC_APP_NAME="Local Service Finder"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox (https://account.mapbox.com/access-tokens/) — required for the
# interactive map, location search, "Use my location" reverse geocode, and
# driving-direction overlays. Public scopes are sufficient (styles:read,
# fonts:read, geocoding:read, directions:read). Without it, map components
# render a friendly fallback and the location picker becomes a freeform
# text input.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Sentry (https://sentry.io) — error + performance monitoring. Leave DSN blank
# to disable reporting entirely (dev/test). The DSN is public-safe.
NEXT_PUBLIC_SENTRY_DSN=
# Release tag — set to the git SHA at build time so errors group by deploy.
NEXT_PUBLIC_SENTRY_RELEASE=
# Build-time only (source-map upload). Set in CI/build env, NOT in the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# PostHog (https://posthog.com) — product analytics. Leave the key blank to
# disable analytics entirely. Capture only runs after the user accepts the
# cookie banner ("Accept all"); "Essential only" keeps PostHog dormant.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com — override for EU cloud or self-hosted.
NEXT_PUBLIC_POSTHOG_HOST=
