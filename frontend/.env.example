# Environment Variables
# Copy this file to .env.local and fill in the values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# App Configuration
NEXT_PUBLIC_APP_NAME="Local Service Finder"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox (https://account.mapbox.com/access-tokens/) — required for the
# interactive map, location search, "Use my location" reverse geocode, and
# driving-direction overlays. Public scopes are sufficient (styles:read,
# fonts:read, geocoding:read, directions:read). Without it, map components
# render a friendly fallback and the location picker becomes a freeform
# text input.
NEXT_PUBLIC_MAPBOX_TOKEN=
